# Copy to .env and fill in the secret; docker compose reads it automatically.

# Base URL of the deployed app: scheme and host only, no path and no trailing slash.
ANALYTICS_BASE_URL=https://zonneplan-telegram.vercel.app

# Must equal the ANALYTICS_SECRET environment variable of the Vercel project.
ANALYTICS_SECRET=change-me

# Grafana administrator login (defaults to admin/admin when unset).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
